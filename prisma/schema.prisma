// SQLite for now. To move to Postgres later: change provider to "postgresql",
// point DATABASE_URL at the new server, and change Site.data from String to
// Json - everything else carries over as-is.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  createdAt    DateTime      @default(now())
  sessions     Session[]
  sites        Site[]
  subscription Subscription?
}

// One row per user who has ever started a paid subscription. Absence of a
// row (or a non-active status) means the free plan — plan rules themselves
// live in lib/plans.ts, not in the database.
model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey                String // "pro" — must match a key in lib/plans.ts
  razorpaySubscriptionId String    @unique
  // Mirrors Razorpay's subscription lifecycle: created → authenticated/active
  // → (halted | cancelled | completed | expired). Only "active" and
  // "authenticated" grant paid features.
  status                 String
  currentPeriodEnd       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// One row per outstanding login code. Codes are stored hashed so a peek at
// the database (or a leaked backup) doesn't hand out working login codes.
model OtpCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Processed Razorpay webhook event ids. Razorpay retries deliveries, so the
// handler records each x-razorpay-event-id and applies an event only once.
model WebhookEvent {
  id        String   @id // Razorpay's event id (evt_...)
  createdAt DateTime @default(now())
}

model Site {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // The full StorefrontData object, JSON-serialized. SQLite has no native
  // JSON column type in Prisma, so it lives in a String.
  data      String
  // Public URL path segment (/s/<slug>). Unique across the whole database.
  // Stays reserved after unpublishing so republishing keeps the same URL.
  slug      String?  @unique
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pageviews     Pageview[]
  reviews       Review[]
  appointments  Appointment[]
  orders        Order[]
  domains       Domain[]
  notifications Notification[]

  @@index([userId])
  @@index([userId, published])
}

// ── Analytics ──────────────────────────────────────────────────────────
model Pageview {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  path      String   @default("/")
  referrer  String?
  userAgent String?
  ip        String?
  country   String?
  createdAt DateTime @default(now())

  @@index([siteId])
  @@index([createdAt])
}

// ── Reviews ────────────────────────────────────────────────────────────
model Review {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([siteId])
}

// ── Appointments ───────────────────────────────────────────────────────
model Appointment {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String
  customerPhone String?
  service   String
  date      String   // ISO date YYYY-MM-DD
  time      String   // HH:MM
  status    String   @default("pending") // pending | confirmed | cancelled
  notes     String?
  createdAt DateTime @default(now())

  @@index([siteId])
  @@index([date])
}

// ── Orders ─────────────────────────────────────────────────────────────
model Order {
  id             String   @id @default(cuid())
  siteId         String
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customerName   String
  customerEmail  String
  customerPhone  String?
  items          String   // JSON: [{name, price, quantity}]
  total          Float
  status         String   @default("pending") // pending | confirmed | delivered | cancelled
  paymentMethod  String   @default("cod")     // cod | razorpay
  paymentId      String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([siteId])
  @@index([createdAt])
}

// ── Custom Domains ─────────────────────────────────────────────────────
model Domain {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  domain      String   @unique
  verified    Boolean  @default(false)
  verificationToken String @default("")
  createdAt   DateTime @default(now())

  @@index([siteId])
}

// ── Notifications log ──────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  type      String   // welcome | publish | billing | appointment | order | marketing
  channel   String   // email | sms | whatsapp
  recipient String
  subject   String?
  body      String
  status    String   @default("sent") // sent | failed | pending
  createdAt DateTime @default(now())

  @@index([siteId])
  @@index([createdAt])
}
